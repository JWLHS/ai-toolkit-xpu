@echo off
chcp 65001 >nul
cd /d "%~dp0..\ui"
if not exist "%~dp0..\.venv-xpu\Scripts\python.exe" (
    echo [!] 还没有初始化环境，先运行 setup_xpu.bat
    pause
    exit /b 1
)
set "PATH=%~dp0..\ffmpeg-shared\ffmpeg-n8.1-latest-win64-gpl-shared-8.1\bin;%PATH%"
start "" "http://localhost:8675"
call npm start
pause
